{
  "$schema": "./registry.schema.json",
  "version": 1,
  "note": "VibeCode QA standards registry. Maps a repo or slice detectable signals to the published or planned standards it should be judged against. Consumers: the vcqa CLI/engine, deterministic resolvers, and AI judges that must use fixed standards instead of memory. See SCHEMA.md.",
  "signals": {
    "note": "Reference of the atoms a `detect` predicate may test, gathered per slice by the resolver.",
    "dep": "a dependency name present in the slice's package.json (deps + devDeps)",
    "file": "an exact file present in the slice",
    "fileGlob": "a glob matched within the slice",
    "config": "a parsed key present (e.g. wrangler.toml has [[d1_databases]])"
  },
  "standards": [
    {
      "id": "react-spa",
      "type": "archetype",
      "title": "React SPA",
      "summary": "React, client-rendered, hosted as static files. No SSR, no server of its own.",
      "url": "https://vibecodeqa.online/standards/react-spa/v1/",
      "repo": "vibecodeqa/vibecodeqa",
      "appliesTo": "slice",
      "status": "published",
      "detect": {
        "all": [
          {
            "dep": "react"
          },
          {
            "dep": "react-dom"
          },
          {
            "anyDep": [
              "vite",
              "webpack",
              "esbuild",
              "@rsbuild/core"
            ]
          },
          {
            "noneDep": [
              "next",
              "nuxt",
              "@remix-run/react",
              "@react-router/dev",
              "express",
              "hono",
              "fastify",
              "@nestjs/core"
            ]
          },
          {
            "noneFileGlob": [
              "functions/**/*.{ts,js}",
              "server/**/*.{ts,js}"
            ]
          }
        ]
      },
      "recommends": [
        "typescript",
        "security",
        "testing",
        "accessibility",
        "dependencies"
      ],
      "optionalLayers": [
        "tailwind",
        "tanstack-query",
        "zod-validation",
        "oauth-client"
      ],
      "editions": [
        {
          "version": "v1",
          "path": "/v1",
          "status": "latest",
          "reviewed": "2026-07",
          "nextReview": "2027-07",
          "targets": {
            "react": "19",
            "vite": "8",
            "tailwind": "4",
            "typescript": "6",
            "node": ">=20.19; prefer 22.12+ or 24 LTS"
          },
          "lifecycle": {
            "deprecated": false,
            "supersededBy": null,
            "errata": [],
            "changelog": []
          }
        }
      ],
      "aliases": [
        "react-spa-static"
      ],
      "standardUrl": "https://vibecodeqa.online/standards/react-spa/v1/",
      "docsUrl": "/docs/standards/stacks/react-spa/"
    },
