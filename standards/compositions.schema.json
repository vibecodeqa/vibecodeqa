{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecodeqa.online/standards/compositions.schema.json",
  "title": "VibeCode QA Standards Composition Map",
  "type": "object",
  "required": ["version", "lastReviewed", "purpose", "principles", "stackItems", "composedStandards"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "purpose": { "type": "string" },
    "principles": { "type": "array", "items": { "type": "string" } },
    "stackItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "references", "vcqaShouldOwn", "docsUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } },
          "vcqaShouldOwn": { "type": "array", "items": { "type": "string" } },
          "docsUrl": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "composedStandards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "aliases", "stackItems", "ownedRules", "benefits", "docsUrl", "standardUrl", "latestEdition"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "stackItems": { "type": "array", "items": { "type": "string" } },
          "optionalStackItems": { "type": "array", "items": { "type": "string" } },
          "ownedRules": { "type": "array", "items": { "type": "string" } },
          "benefits": { "type": "array", "items": { "type": "string" } },
          "docsUrl": { "type": "string" },
          "standardUrl": { "type": ["string", "null"] },
          "latestEdition": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "referenceImplementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repo", "url", "status", "standards", "demonstratesPrimary", "demonstrates", "note", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "repo": { "type": "string" },
          "url": { "type": "string" },
          "status": { "type": "string", "enum": ["published", "experimental", "candidate"] },
          "standards": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "demonstratesPrimary": { "type": ["string", "null"], "pattern": "^[a-z0-9-]+$" },
          "demonstrates": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "evidence": {
            "type": ["object", "null"],
            "required": [
              "reportUrl",
              "score",
              "grade",
              "assessedCommit",
              "assessedAt",
              "ciRunUrl",
              "ciConclusion",
              "ciRunAt",
              "independentAssessmentUrl",
              "verifiedAt"
            ],
            "properties": {
              "reportUrl": { "type": "string" },
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "grade": { "type": ["string", "null"], "pattern": "^[A-F]$" },
              "assessedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "assessedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "ciRunUrl": { "type": "string" },
              "ciConclusion": { "type": "string" },
              "ciRunAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "independentAssessmentUrl": { "type": ["string", "null"] },
              "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
